
> library("httr")

> library("RCurl")

> library("foreign")

> library("compute.es")

> source("http://sachaepskamp.com/files/OSF/getOSFfile.R")

> file <- getOSFfile("https://osf.io/nd7we/")

> lobue.data <- read.spss(file, to.data.frame = TRUE)

> options(contrasts = c("contr.sum", "contr.poly"))

> lobue.aov <- aov(average ~ parentvschild * Stim_cond, 
+     data = lobue.data)

> summary(lobue.aov)
                        Df    Sum Sq   Mean Sq F value   Pr(>F)    
parentvschild            1 117401159 117401159  52.787 4.68e-09 ***
Stim_cond                1   3488302   3488302   1.568    0.217    
parentvschild:Stim_cond  1   3534648   3534648   1.589    0.214    
Residuals               44  97858296   2224052                     
---
Signif. codes:  0 '***' 0.001 '**' 0.01 '*' 0.05 '.' 0.1 ' ' 1

> lobue.aovss3 <- drop1(lobue.aov, ~., test = "F")

> print(lobue.aovss3)
