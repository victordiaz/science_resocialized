> lobue.aovss3[["F value"]][[4]]
[1] 1.589283

> lobue.aovss3[["Pr(>F)"]][[4]]
[1] 0.2140729

> nrow(lobue.data)
[1] 48

> sumsq.error <- lobue.aovss3[["RSS"]][[1]]

> sumsq.effect <- lobue.aovss3[["Sum of Sq"]][[4]]

> effect.size <- sumsq.effect/(sumsq.effect + sumsq.error)

> print(effect.size)
[1] 0.03486089

> TRUE
