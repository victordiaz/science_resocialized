
> library("httr")

> library("RCurl")

> library("compute.es")

> source("http://sachaepskamp.com/files/OSF/getOSFfile.R")

> file <- getOSFfile("https://osf.io/dy3zn/")

> mcdata <- read.csv(file, as.is = TRUE)

> mcdata$Cond <- factor(mcdata$Cond)

> levels(mcdata$Cond) <- c("Handicap", "Control")

> mcdata$Cond <- relevel(mcdata$Cond, ref = "Control")

> mct.test <- t.test(Correct/Attempted ~ Cond, data = mcdata, 
+     alternative = "greater", var.equal = TRUE)

> print(mct.test)

	Two Sample t-test

data:  Correct/Attempted by Cond
t = 2.3255, df = 59, p-value = 0.01175
alternative hypothesis: true difference in means between group Control and group Handicap is greater than 0
95 percent confidence interval:
 0.03300357        Inf
sample estimates:
 mean in group Control mean in group Handicap 
             0.5834651              0.4661788 


> mct.test$statistic
       t 
2.325462 

> mct.test$p.value
[1] 0.0117526

> nrow(mcdata)
[1] 61

> t = mct.test$statistic

> n = nrow(mcdata)

> efd = t/sqrt(n)

> effectSize <- des(efd, n.1 = n, n.2 = n, level = 95, 
+     dig = 2, id = NULL, data = NULL)
