# Copy to backend/.env
ANTHROPIC_API_KEY=sk-ant-...
# Optional
# MAX_AGENT_STEPS=40        # tool-use steps per reviewer per round
# LIVE_REPLY_STEPS=12       # steps for an immediate reply to a human
# AGENT_EFFORT=high         # low | medium | high | xhigh | max
# PAPER_REVIEW_DATA=./data  # where the database and PDFs live
# PIPELINE_MODEL=claude-sonnet-5-5   # extraction, leak check, paper details
# LOCAL_WORKER=1                     # start the replication worker on this machine
# REPLICATION_BUDGET_USD=10          # default Claude Code budget per replication
# REPLICATION_TIMEOUT_MIN=120        # wall-clock limit per replication
# PUBLIC_URL=http://127.0.0.1:8000   # URL the local worker uses to reach the API
# WORKER_TOKEN=...                   # default: generated in data/worker_token
# ATTACHMENT_MAX_MB=2048            # largest file people can attach for the replicator
